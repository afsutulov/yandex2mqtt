{
  "id": "thermostat",
  "name": "Термостат",
  "room": "Гостиная",
  "type": "devices.types.thermostat",
  "allowedUsers": [
    "1"
  ],
  "mqtt": [
    {
      "instance": "on",
      "set": "home/thermostat/power/set",
      "state": "home/thermostat/power",
      "confirmTimeoutMs": 1000
    },
    {
      "instance": "temperature",
      "type": "devices.capabilities.range",
      "set": "home/thermostat/target/set",
      "state": "home/thermostat/target",
      "confirmTimeoutMs": 1000
    },
    {
      "instance": "temperature",
      "type": "devices.properties.float",
      "state": "home/thermostat/actual"
    },
    {
      "instance": "thermostat",
      "set": "home/thermostat/mode/set",
      "state": "home/thermostat/mode"
    }
  ],
  "capabilities": [
    {
      "type": "devices.capabilities.on_off",
      "retrievable": true,
      "reportable": true
    },
    {
      "type": "devices.capabilities.range",
      "retrievable": true,
      "reportable": true,
      "parameters": {
        "instance": "temperature",
        "unit": "unit.temperature.celsius",
        "random_access": true,
        "range": {
          "min": 16,
          "max": 30,
          "precision": 1
        }
      }
    },
    {
      "type": "devices.capabilities.mode",
      "retrievable": true,
      "reportable": true,
      "parameters": {
        "instance": "thermostat",
        "modes": [
          {
            "value": "heat"
          },
          {
            "value": "cool"
          },
          {
            "value": "auto"
          }
        ]
      }
    }
  ],
  "properties": [
    {
      "type": "devices.properties.float",
      "retrievable": true,
      "reportable": true,
      "parameters": {
        "instance": "temperature",
        "unit": "unit.temperature.celsius"
      }
    }
  ]
}
