[Unit]
Description=Yandex Smart Home to MQTT bridge (Go)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yandex2mqtt
Group=yandex2mqtt
WorkingDirectory=/opt/yandex2mqtt
ExecStart=/opt/yandex2mqtt/yandex2mqtt -config /opt/yandex2mqtt/config.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/yandex2mqtt/data

[Install]
WantedBy=multi-user.target
