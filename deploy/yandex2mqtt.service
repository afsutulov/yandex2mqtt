[Unit]
Description=Yandex Smart Home to MQTT bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt
ExecStart=/opt/yandex2mqtt -config /etc/yandex2mqtt.conf
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt

[Install]
WantedBy=multi-user.target
